# ─── Supabase (required) ───
# Project URL + anon key from supabase.com → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ─── RevenueCat (required for production, optional in dev) ───
# Public API keys from app.revenuecat.com → Project → Apps
# Leave empty to run payments in demo mode.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# ─── EAS (required to build for production) ───
# Project ID from expo.dev → your project → Settings
EAS_PROJECT_ID=

# ─── Flutterwave (server-side, set in Supabase Edge Function secrets, NOT here) ───
# These are NOT client-side. They live in Supabase project secrets so the secret
# key never ships in the app bundle. Set via:
#   supabase secrets set FLUTTERWAVE_SECRET_KEY=... --project-ref <ref>
#   supabase secrets set FLUTTERWAVE_WEBHOOK_SECRET=... --project-ref <ref>
#   supabase secrets set FLUTTERWAVE_REDIRECT_URL=https://yourdomain/payment/callback --project-ref <ref>

# ─── Stripe (web payment rail) ───
# Publishable key is safe to ship; only used if you mount Stripe Elements in a
# web build later. The Checkout-redirect path used by mobile WebView doesn't need it.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Server-only Stripe secrets (set in Supabase project secrets, NOT here) ──
#   supabase secrets set STRIPE_SECRET_KEY=sk_test_... --project-ref <ref>
#   supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_... --project-ref <ref>
# Webhook endpoint to register at https://dashboard.stripe.com/webhooks:
#   https://<project-ref>.supabase.co/functions/v1/stripe-webhook
# Events: checkout.session.completed, customer.subscription.updated,
#         customer.subscription.deleted, invoice.payment_failed
#
# To bootstrap or refresh the 12 products + prices in your Stripe account, run:
#   STRIPE_SECRET_KEY=sk_test_... node scripts/setup-stripe-products.js
# Then sync the Price IDs into supabase/functions/_shared/stripe-products.ts.

