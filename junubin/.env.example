# Junubin — Environment variables reference
#
# Copy to .env.local and fill in real values for local dev, OR set
# each EXPO_PUBLIC_* var in EAS (`eas secret:create`) for cloud builds.
# Anything prefixed EXPO_PUBLIC_ is bundled into the client JS at
# build time. Server-side secrets (Supabase Edge Functions, webhooks)
# are set separately via `supabase secrets set`.
#
# Three tiers — REQUIRED-FOR-PROD is non-negotiable (the production
# build throws at config-load if any are missing — see app.config.js),
# REQUIRED-FOR-FEATURE-X gates a single feature, OPTIONAL is
# observability / polish.
#
# ─── REQUIRED FOR PRODUCTION ───────────────────────────────────────

# Supabase project URL + anon key (Settings → API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps API key — Android only. iOS uses Apple MapKit and
# needs no key. Without this the Android PeopleMap renders as a
# blank gray tile with a "For development purposes only" watermark.
# Enable "Maps SDK for Android" in Google Cloud Console; restrict
# the key to your package id + release / debug SHA-1 fingerprints.
# Free tier: 100k loads / month → past 30k MAU before billed.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# EAS project id from expo.dev → your project → Settings
EAS_PROJECT_ID=

# ─── REQUIRED FOR SIGNUP — NOT AN ENV VAR ──────────────────────────
#
# Phone OTP (src/auth/AuthContext.js → supabase.auth.signInWithOtp)
# needs an SMS provider configured in the Supabase dashboard:
#   Authentication → Providers → Phone → enable, then supply Twilio /
#   MessageBird / Vonage credentials.
# There is no env var for this and no code change that substitutes for
# it. Until it is configured, every real signup fails at the six-digit
# step and the only way into the app is the __DEV__-gated bypass in
# src/config/devAuth.js, which no built binary can reach.
#
# Likewise the app advertises https://junubin.app for its privacy
# policy, terms, support page and universal links. That domain must
# resolve and serve the files in website/ before App Review, or the
# reviewer follows a dead link.

# ─── PAYMENTS ──────────────────────────────────────────────────────
#
# None. JuNubin is free — the Stripe / Flutterwave / RevenueCat keys
# that used to live here were removed with the payments stack. If you
# are looking for them because something referenced a subscription
# tier, that reference is stale; report it rather than re-adding keys.

# ─── REQUIRED FOR LIVENESS (Active face verification) ──────────────

# Toggle this to "aws-amplify" once @aws-amplify/ui-react-native is
# installed and you have AWS credentials. Until then the liveness
# check runs as a time-based UI scaffold (no real grading).
EXPO_PUBLIC_LIVENESS_PROVIDER=none
# AWS region for the Amplify FaceLivenessDetector component. Must
# match the AWS_REGION supabase secret on the server side.
EXPO_PUBLIC_AWS_REGION=us-east-1

# ─── REQUIRED FOR OBSERVABILITY (highly recommended) ───────────────

# Sentry DSN. Free tier = 5k errors/month. Without this every
# production crash is invisible.
EXPO_PUBLIC_SENTRY_DSN=

# PostHog analytics. Free tier = 1M events/month. Powers the
# signup → swipe → match → message funnel report.
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── OPTIONAL ──────────────────────────────────────────────────────

# Dev-only auth bypass — skips OTP on the Signup screen so a
# developer can flow through the app without a real phone/email.
# DO NOT set this in production builds.
# EXPO_PUBLIC_DEV_BYPASS_AUTH=true

# ─── SERVER-SIDE ONLY (set via `supabase secrets set ...`) ─────────
#
# These never go in .env.local — they're set against the Supabase
# project so only Edge Functions can read them.
#
#   NODE_ENV=production                # 🔴 toggles moderate-image fail-closed
#   JUNUBIN_INTERNAL_SECRET=<random>   # 🔴 pg_net trigger → push-send auth
#   MODERATION_PROVIDER=aws            # 🔴 (or google / sightengine)
#   AWS_ACCESS_KEY_ID=...              # 🔴 for moderate-image + face-liveness
#   AWS_SECRET_ACCESS_KEY=...          # 🔴
#   AWS_REGION=us-east-1               # 🔴
#   SENTRY_DSN=...                     # 🟡 edge-side capture
#   LIVENESS_PASS_THRESHOLD=75         # 🟢 default ok
#
# One-time SQL to wire pg_net push triggers (run once in SQL editor):
#   ALTER DATABASE postgres SET "app.edge_url"        = 'https://<ref>.supabase.co/functions/v1';
#   ALTER DATABASE postgres SET "app.service_key"     = '<service-role-jwt>';
#   ALTER DATABASE postgres SET "app.internal_secret" = '<same as JUNUBIN_INTERNAL_SECRET>';
