# ──────────────────────────────────────────────
# JuNubin API — Production Environment Variables
# ──────────────────────────────────────────────
# Copy to .env.production and fill in real values.
# On Render, set these in the Dashboard > Environment tab.

# ─── Required ───────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/junubin?sslmode=require
JWT_SECRET=replace-with-a-64-char-random-hex-string

# ─── Server ─────────────────────────────────
NODE_ENV=production
PORT=4000
JWT_EXPIRES_IN=7d

# Comma-separated allowed origins for CORS
# Example: https://junubin.com,https://app.junubin.com
CORS_ORIGIN=https://your-production-domain.com

# ─── Cloudinary (required for photo uploads) ─
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Optional ───────────────────────────────
# Set to "true" only for staging — NEVER in production
ENABLE_DEV_OTP_BYPASS=false

# Matching algorithm tuning
# 0..1 (higher = more exploration/variety)
MATCH_EXPLORE_RATE=0.12
# Candidate shuffle window size (2..20)
MATCH_WINDOW_SIZE=5
# Behavioral model activates after this many swipes
MATCH_BEHAVIORAL_MIN_SWIPES=20
# Per-signal multipliers (JSON). Keep values between 0 and 4.
# Example:
# MATCH_WEIGHTS_JSON={"sharedInterests":1.2,"currentlyInto":1.4,"recency":0.9}
MATCH_WEIGHTS_JSON=

# Ranking analytics (structured JSON logs)
MATCH_ANALYTICS_ENABLED=true
MATCH_ANALYTICS_SAMPLE_RATE=0.05
MATCH_ANALYTICS_TOP_K=3
