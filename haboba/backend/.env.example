# Required
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/junubin
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars

# Optional
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:8081
JWT_EXPIRES_IN=7d

# Cloudinary (optional — falls back to base64 in dev)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Matching tuning (optional)
MATCH_EXPLORE_RATE=0.15
MATCH_WINDOW_SIZE=5
MATCH_BEHAVIORAL_MIN_SWIPES=20
# JSON object; each key 0..4 multiplier.
# Keys: sharedInterests, datingIntentions, recency, verified, photos, bio,
# culturalAffinity, keywordOverlap, profileFreshness, currentlyInto,
# behavioral, popularity, collaborative
MATCH_WEIGHTS_JSON=

# Ranking analytics (optional; emits JSON logs)
MATCH_ANALYTICS_ENABLED=false
MATCH_ANALYTICS_SAMPLE_RATE=0.10
MATCH_ANALYTICS_TOP_K=3
