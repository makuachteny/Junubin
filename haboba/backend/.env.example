# Required
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/junubin
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars

# Optional
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:8081
JWT_EXPIRES_IN=7d

# Cloudinary (optional — falls back to base64 in dev)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
